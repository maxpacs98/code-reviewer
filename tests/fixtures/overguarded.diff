diff --git a/src/orders/service.ts b/src/orders/service.ts
index 1111111..2222222 100644
--- a/src/orders/service.ts
+++ b/src/orders/service.ts
@@ -1,4 +1,26 @@
 import { Order } from "./model";
-export function total(order: Order): number {
-  return order.lines.reduce((sum, line) => sum + line.price, 0);
+
+export function total(order?: Order | null): number {
+  if (!order) return 0;
+  if (order === undefined || order === null) {
+    return 0;
+  }
+  const lines = order?.lines ?? [];
+  let sum = 0;
+  for (const line of lines || []) {
+    try {
+      const price = typeof line?.price === "number" ? line.price : 0;
+      sum += price ?? 0;
+    } catch (e) {
+    }
+  }
+  return sum;
+}
+
+export function label(order: Order): string {
+  // @ts-ignore legacy field
+  const name = (order as any)?.customer?.name ?? "";
+  return name || "";
+}
+
+export const url = "https://example.com/orders?.json";
 }
